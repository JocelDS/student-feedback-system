# Copy this file to .env for local development. NEVER commit .env to GitHub.

PORT=5000

# Supabase: Project Settings > API
SUPABASE_URL=https://ygpkkzximsgkfezhiihq.supabase.co
# The service_role key is a SECRET. It must only live on the backend.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# Admin login
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- "YourStrongPassword"
ADMIN_PASSWORD_HASH=paste-the-bcrypt-hash-here
# Any long random string, for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Frontend URL(s) allowed to call this API (comma-separated, no trailing slash)
CLIENT_ORIGIN=http://localhost:5173
